#!/usr/bin/env bash
# Every service of docker-compose.yml has a CPU ceiling: without one, a stack's rebuild or smoke run takes every core
# and the tests of the worktree stacks beside it time out. Run by gate.sh from the repo root.
set -euo pipefail
docker compose --profile '*' config --format json | python3 -c '
import json, sys
services = json.load(sys.stdin)["services"]
missing = sorted(name for name, service in services.items() if not service.get("cpus"))
if missing:
    sys.exit("No cpus ceiling: " + ", ".join(missing))
print("every service has a cpus ceiling")
'
