# Defaults for the local Docker stack. Real values (production, or your own keys) go in .env.local, which is
# gitignored; on cPanel see deploy/env.local.example.
APP_ENV=dev
APP_SECRET=
DEFAULT_URI=http://localhost:8080
# Production runs MySQL 8.x; keep serverVersion in step with it (deploy/cpanel-update.sh checks).
DATABASE_URL="mysql://app:app@database:3306/app?serverVersion=8.0&charset=utf8mb4"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=smtp://mailpit:1025
# The order email (Ordering): sender, and the printer that receives every new order. Empty: no email, a log row.
MAILER_FROM_ADDRESS=orders@kf.local
MAILER_FROM_NAME="KF Inventory"
MAILER_PRINTER_ADDRESS=printer@kf.local
# Seals the secrets kept in the database (SMTP password, shop keys, webhook secrets): 64 hex characters (32 bytes).
# This one is for local stacks only; production generates its own (deploy/env.local.example).
APP_ENCRYPTION_KEY=c761e3cb4c3ab7f12ce55540e1a4954d81360b072eb3a44e05861c31a8e77aff
