{
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-sodium": "*",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^3.3 || ^4.0",
    "doctrine/orm": "^3.2",
    "dompdf/dompdf": "^3.1.6",
    "gedmo/doctrine-extensions": "^3.14",
    "guzzlehttp/guzzle": "^7.0",
    "phpdocumentor/reflection-docblock": "^5.3",
    "phpoffice/phpspreadsheet": "^2.0",
    "phpstan/phpdoc-parser": "^1.6",
    "ramsey/uuid": "^4.7",
    "symfony/asset": "8.0.*",
    "symfony/clock": "8.0.*",
    "symfony/console": "8.0.*",
    "symfony/doctrine-messenger": "8.0.*",
    "symfony/dotenv": "8.0.*",
    "symfony/expression-language": "8.0.*",
    "symfony/flex": "^2.4",
    "symfony/framework-bundle": "8.0.*",
    "symfony/mailer": "8.0.*",
    "symfony/messenger": "8.0.*",
    "symfony/monolog-bundle": "^3.10 || ^4.0",
    "symfony/polyfill-php86": "^1.33",
    "symfony/process": "8.0.*",
    "symfony/property-access": "8.0.*",
    "symfony/property-info": "8.0.*",
    "symfony/runtime": "8.0.*",
    "symfony/security-bundle": "8.0.*",
    "symfony/serializer": "8.0.*",
    "symfony/translation": "8.0",
    "symfony/twig-bundle": "8.0.*",
    "symfony/validator": "8.0.*",
    "symfony/webpack-encore-bundle": "^2.1",
    "symfony/yaml": "8.0.*"
  },
  "require-dev": {
    "dama/doctrine-test-bundle": "^8.6",
    "deptrac/deptrac": "^4.7",
    "doctrine/doctrine-fixtures-bundle": "^4.0",
    "friendsofphp/php-cs-fixer": "^3.95",
    "nelmio/api-doc-bundle": "^5.10",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^11.0",
    "symfony/browser-kit": "8.0.*",
    "symfony/css-selector": "8.0.*",
    "symfony/debug-bundle": "8.0.*",
    "symfony/maker-bundle": "^1.0",
    "symfony/phpunit-bridge": "8.0.*",
    "symfony/stopwatch": "8.0.*",
    "symfony/web-profiler-bundle": "8.0.*"
  },
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true,
      "phpstan/extension-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "paragonie/random_compat": "2.*",
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php71": "*",
    "symfony/polyfill-php70": "*",
    "symfony/polyfill-php56": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "deptrac": [
      "deptrac analyse --config-file=deptrac.yaml --no-progress",
      "deptrac analyse --config-file=deptrac.contexts.yaml --no-progress"
    ],
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "test": [
      "@php bin/console cache:warmup --env=test -q",
      "phpunit"
    ],
    "test:prepare": [
      "@php bin/console cache:warmup --env=test -q",
      "php bin/console doctrine:database:create --env=test --if-not-exists -q",
      "php bin/console doctrine:migrations:migrate --env=test -n -q"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.0.*"
    }
  }
}
