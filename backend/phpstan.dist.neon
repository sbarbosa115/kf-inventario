# PHPStan: docker compose exec php vendor/bin/phpstan
# Findings are fixed, not baselined: a deliberate exception goes in ignoreErrors with its reason.
# Level 6 for the restructure (docs/pdr/prd-restructure.md, decision 13); raise one level at a time afterwards.
parameters:
    level: 6
    paths:
        - src
        - tests
    tmpDir: var/cache/phpstan
    symfony:
        # The test container: the tests run against it, and it holds every app service.
        # Warm it first: docker compose exec php php bin/console cache:warmup --env=test
        containerXmlPath: var/cache/test/App_KernelTestDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/phpstan-object-manager.php
    ignoreErrors:
        # The moved entities keep the nullable PHP properties they had over NOT NULL columns (set before the first
        # flush; the database refuses a null). Making them non-nullable means constructors that take the required
        # fields, which each context's item does when it rewrites the model's use cases; not part of the move.
        -
            identifier: doctrine.columnType
            message: '#property can contain .+\|null but database expects#'
            path: src/*/Domain/Model/*
        -
            identifier: doctrine.associationType
            message: '#property can contain .+\|null but database expects#'
            path: src/*/Domain/Model/*
