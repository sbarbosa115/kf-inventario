<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#23241c" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#141612" media="(prefers-color-scheme: dark)">
    <meta name="color-scheme" content="light dark">
    <title>KF Inventory</title>
    {# The theme and the language before the first paint (no white flash in dark): kf.theme is light, dark or system,
       kf.locale en or es (else the browser's language). shared/lib/theme.ts and shared/i18n keep them afterwards. #}
    <script>
        (function () {
            var root = document.documentElement;
            var theme = 'light';
            var locale = 'en';
            try {
                var chosen = window.localStorage.getItem('kf.theme');
                var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                theme = chosen === 'light' || chosen === 'dark' ? chosen : (dark ? 'dark' : 'light');
                var language = window.localStorage.getItem('kf.locale');
                locale = language === 'en' || language === 'es' ? language
                    : (String(navigator.language || '').toLowerCase().indexOf('es') === 0 ? 'es' : 'en');
            } catch (e) {
                // Storage refused (private mode, blocked site data): the defaults.
            }
            root.setAttribute('data-theme', theme);
            root.setAttribute('lang', locale);
        })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    {{ encore_entry_link_tags('spa') }}
    {{ encore_entry_script_tags('spa') }}
</head>
<body>
    {# React replaces whatever the server wrote in #root when it starts. #}
    <div id="root"></div>
</body>
</html>
