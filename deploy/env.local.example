# The production settings of kf-inventory, read by Symfony from backend/.env.local (gitignored). Copy this file there
# on the server, fill it in, and `chmod 600 backend/.env.local`. backend/.env (committed) holds the local defaults;
# anything here overrides it.

APP_ENV=prod
# 32 random hex characters: `php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'`. Changing it signs everyone out.
APP_SECRET=

# The site's own address: links in emails and the PDFs use it.
DEFAULT_URI=https://inventory.example.com

# Production runs MySQL 8.x: serverVersion must say the server's version (deploy/cpanel-update.sh checks).
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE?serverVersion=8.0&charset=utf8mb4"

# The email queue: a table in this database (messenger_messages), drained by the cron line the deploy script prints.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# How email leaves: the account's SMTP (cPanel › Email Accounts › Connect Devices), e.g.
# smtp://orders%40example.com:PASSWORD@mail.example.com:465
MAILER_DSN=
# The order email: who sends it, and the printer that receives every new order (cc: sales@klassicfab.com, set in
# config/services.yaml). Empty MAILER_PRINTER_ADDRESS: no email is sent, and a "mail" row is logged instead.
MAILER_FROM_ADDRESS=
MAILER_FROM_NAME=
MAILER_PRINTER_ADDRESS=

# WooCommerce orders arriving through the webhook for this warehouse id send the printer email (as before: 1).
ORDER_WEBHOOK_EMAIL_WAREHOUSE_ID=1

# The WooCommerce REST API: the Orders screen's "Sync Orders" button pulls the shop's waiting orders (status
# processing, last 30 days) with these keys and places the ones the app does not have yet, as the webhook would.
# One shop: its orders go to the warehouse whose `urls` hold WOO_COMMERCE_URL (the address the shop's webhook comes
# from, e.g. https://shop.example.com/; with or without the trailing slash). Leave any of the three empty and the
# button places nothing. Read-only keys: WooCommerce › Settings › Advanced › REST API › Add key, permission "Read".
WOO_COMMERCE_URL=
WOO_COMMERCE_API_KEY=
WOO_COMMERCE_API_SECRET=

# The webhook's secret: WooCommerce › Settings › Advanced › Webhooks › (the order webhook) › Secret. Empty (as before),
# the webhook URL alone admits an order; set, every delivery must carry the shop's X-WC-Webhook-Signature (HMAC-SHA256
# of the body with this secret), and one without it is logged and not placed. Copy it exactly from the shop.
WOO_COMMERCE_WEBHOOK_SECRET=
