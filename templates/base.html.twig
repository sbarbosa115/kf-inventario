<!DOCTYPE html>
<html lang="{{ app.request.locale|split('_')[0] }}">
    <head>
        <meta charset="UTF-8">
        <title>Inventory | {% block title %}{% endblock %}</title>
        <link rel="stylesheet" href="{{ asset('build/app.css') }}">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <style>
            .sidebar .nav-item .nav-link.active {
                font-weight: 600;
                background-color: rgba(255,255,255,0.08);
                border-left: 3px solid #fff;
                padding-left: calc(1rem - 3px);
            }
            .sidebar-section {
                padding: 0.6rem 1rem 0.25rem;
                font-size: 0.65rem;
                font-weight: 700;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: rgba(255,255,255,0.35);
                margin-top: 0.5rem;
            }
            .sidebar-divider {
                border-top: 1px solid rgba(255,255,255,0.1);
                margin: 0.25rem 0;
            }
            #content-wrapper {
                display: flex;
                flex-direction: column;
                min-height: calc(100vh - 56px);
            }
            .app-footer {
                margin-top: auto;
                padding: 0.75rem 1rem;
                font-size: 0.78rem;
                color: #adb5bd;
                border-top: 1px solid #e9ecef;
                background: #f8f9fa;
            }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>

    {% block body %}
        {% set route = app.request.attributes.get('_route') %}
        <body id="page-top">
            <nav class="navbar navbar-expand navbar-dark bg-dark static-top">
                <a class="navbar-brand mr-1" href="{{ path('product_product_index') }}">
                    <i class="fas fa-boxes mr-1"></i> Inventory
                </a>
                <button class="btn btn-link btn-sm text-white order-1 order-sm-0" id="sidebarToggle" href="#">
                    <i class="fas fa-bars"></i>
                </button>
                <ul class="navbar-nav ml-auto ml-md-0">
                    <li class="nav-item dropdown no-arrow">
                        <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-user-circle fa-fw"></i>
                            {% if app.user is defined and app.user is not null %}
                                {{ app.user.email }}
                            {% endif %}
                        </a>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="userDropdown">
                            <div class="dropdown-header text-muted small">
                                {{ 'welcome'|trans }}
                            </div>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="{{ path('app_logout') }}">
                                <i class="fas fa-sign-out-alt fa-fw mr-1"></i> Logout
                            </a>
                        </div>
                    </li>
                </ul>
            </nav>

            <div id="wrapper">
                <!-- Sidebar -->
                <ul class="sidebar navbar-nav">

                    {% if is_granted('ROLE_MANAGE_INVENTORY') or is_granted('ROLE_MANAGE_WAREHOUSES') %}
                        <li class="sidebar-section">{{ 'products'|trans }}</li>
                    {% endif %}

                    {% if is_granted('ROLE_MANAGE_INVENTORY') %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle {% if route in ['product_product_index','product_product_upload','product_bar_code','product_incoming'] %}active{% endif %}"
                           href="#" id="pagesDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-fw fa-boxes"></i>
                            <span>{{ 'products'|trans }}</span>
                        </a>
                        <div class="dropdown-menu" aria-labelledby="pagesDropdown">
                            <a class="dropdown-item {% if route == 'product_product_index' %}active{% endif %}"
                               href="{{ path('product_product_index') }}">{{ 'product_list'|trans }}</a>
                            <a class="dropdown-item {% if route == 'product_product_upload' %}active{% endif %}"
                               href="{{ path('product_product_upload') }}">{{ 'products_upload'|trans }}</a>
                            <a class="dropdown-item {% if route == 'product_bar_code' %}active{% endif %}"
                               href="{{ path('product_bar_code') }}">{{ 'product.update.bar-code.title'|trans }}</a>
                            <a class="dropdown-item {% if route == 'product_incoming' %}active{% endif %}"
                               href="{{ path('product_incoming') }}">{{ 'product.incoming.title'|trans }}</a>
                        </div>
                    </li>
                    {% endif %}

                    {% if is_granted('ROLE_MANAGE_WAREHOUSES') %}
                    <li class="nav-item">
                        <a class="nav-link {% if route == 'warehouse_warehouse_index' %}active{% endif %}"
                           href="{{ path('warehouse_warehouse_index') }}">
                            <i class="fas fa-fw fa-warehouse"></i>
                            <span>{{ 'warehouses'|trans }}</span>
                        </a>
                    </li>
                    {% endif %}

                    {% if is_granted('ROLE_UPDATE_ORDERS') or is_granted('ROLE_UPDATE_INVOICES') or is_granted('ROLE_MANAGE_CUSTOMERS') %}
                        <li class="sidebar-divider"></li>
                        <li class="sidebar-section">Sales</li>
                    {% endif %}

                    {% if is_granted('ROLE_UPDATE_ORDERS') %}
                    <li class="nav-item">
                        <a class="nav-link {% if route starts with 'order_' %}active{% endif %}"
                           href="{{ path('order_index') }}">
                            <i class="fas fa-fw fa-shopping-cart"></i>
                            <span>{{ 'order.index.title'|trans }}</span>
                        </a>
                    </li>
                    {% endif %}

                    {% if is_granted('ROLE_UPDATE_INVOICES') %}
                    <li class="nav-item">
                        <a class="nav-link {% if route starts with 'invoice_' %}active{% endif %}"
                           href="{{ path('invoice_index') }}">
                            <i class="fas fa-fw fa-file-invoice-dollar"></i>
                            <span>{{ 'invoice.index.title'|trans }}</span>
                        </a>
                    </li>
                    {% endif %}

                    {% if is_granted('ROLE_MANAGE_CUSTOMERS') %}
                    <li class="nav-item">
                        <a class="nav-link {% if route starts with 'customer_' %}active{% endif %}"
                           href="{{ path('customer_index') }}">
                            <i class="fas fa-fw fa-users"></i>
                            <span>{{ 'customer.index.title'|trans }}</span>
                        </a>
                    </li>
                    {% endif %}

                    {% if is_granted('ROLE_MANAGE_USERS') %}
                        <li class="sidebar-divider"></li>
                        <li class="sidebar-section">Admin</li>
                        <li class="nav-item">
                            <a class="nav-link {% if route starts with 'user_' %}active{% endif %}"
                               href="{{ path('user_index') }}">
                                <i class="fas fa-fw fa-user-cog"></i>
                                <span>{{ 'user.index.title'|trans }}</span>
                            </a>
                        </li>
                    {% endif %}
                </ul>

                <div id="content-wrapper">
                    <div class="container-fluid pt-3">
                        {% for label, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="alert alert-{{ label }} alert-dismissible fade show auto-dismiss" role="alert">
                                    {{ message|trans }}
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                            {% endfor %}
                        {% endfor %}

                        {% block content %}{% endblock %}
                    </div>

                    <footer class="app-footer">
                        Inventory &copy; {{ "now"|date("Y") }}
                    </footer>
                </div>
            </div>

            <script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-3.6.0.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.7/dist/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
            <script src="{{ asset('build/app.js') }}"></script>
            <script src="{{ url('bazinga_jstranslation_js') }}"></script>
            <script>
                // Auto-dismiss flash alerts after 4 s
                setTimeout(function () {
                    document.querySelectorAll('.auto-dismiss').forEach(function (el) {
                        el.classList.remove('show');
                        setTimeout(function () { el.remove(); }, 200);
                    });
                }, 4000);
            </script>
            {% block javascripts %}{% endblock %}
        </body>
    {% endblock %}
</html>
