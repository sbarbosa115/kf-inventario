{% extends 'base.html.twig' %}

{% block title %}{{ 'security.login.title'|trans }}{% endblock %}

{% block body %}
<body class="bg-dark" style="min-height:100vh; display:flex; align-items:center; justify-content:center;">
    <div style="width:100%; max-width:400px; padding: 1rem;">

        <div class="text-center mb-4">
            <i class="fas fa-boxes fa-3x text-white mb-2"></i>
            <h3 class="text-white font-weight-light">Inventory</h3>
        </div>

        <div class="card shadow-lg border-0">
            <div class="card-header bg-primary text-white text-center py-3">
                <h5 class="mb-0">{{ 'log_in'|trans }}</h5>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    {% if error %}
                        <div class="alert alert-danger py-2">
                            <i class="fas fa-exclamation-circle mr-1"></i>{{ error.messageKey }}
                        </div>
                    {% endif %}

                    <div class="form-group">
                        <label for="inputUsername" class="small font-weight-bold text-muted text-uppercase">
                            {{ 'security.login.form.username'|trans }}
                        </label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                            </div>
                            <input type="text" value="{{ last_username }}" name="_username" id="inputUsername"
                                   class="form-control" placeholder="{{ 'security.login.form.username'|trans }}"
                                   required autofocus>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="inputPassword" class="small font-weight-bold text-muted text-uppercase">
                            {{ 'security.login.form.password'|trans }}
                        </label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            </div>
                            <input type="password" name="_password" id="inputPassword"
                                   class="form-control" placeholder="{{ 'security.login.form.password'|trans }}" required>
                        </div>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="form-group d-flex align-items-center justify-content-between">
                        <label class="mb-0">
                            <input type="checkbox" name="_remember_me" class="mr-1"> Remember me
                        </label>
                    </div>

                    <button class="btn btn-primary btn-block" type="submit">
                        <i class="fas fa-sign-in-alt mr-1"></i>
                        {{ 'security.login.form.log_in'|trans }}
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script src="{{ asset('build/app.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
{% endblock %}
